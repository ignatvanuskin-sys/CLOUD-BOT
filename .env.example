NODE_ENV=development
PORT=8787
TRUST_PROXY_HOPS=1
METRICS_TOKEN=change-me-to-a-random-16-plus-character-secret
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer-change-me
OTEL_SERVICE_NAME=cloud-bot
OTEL_METRIC_EXPORT_INTERVAL_MS=30000
BOT_TOKEN=123456:telegram-bot-token
BOT_USERNAME=your_bot_username
WEBAPP_URL=https://your-domain.example
CORS_ORIGIN=https://your-domain.example
WEBHOOK_SECRET=change-me-at-least-16-chars

# DB: production must use postgres. SQLite is local/test only.
DB_DRIVER=sqlite
DATABASE_PATH=./data/cloud-bot.sqlite
DATABASE_URL=postgresql://user:password@host:5432/cloud_bot
DATABASE_SSL=true
DATABASE_POOL_MAX=10

SESSION_TTL_SECONDS=3600
ALLOW_DEV_LOGIN=false
ADMIN_TELEGRAM_IDS=123456789

# Redis: production required for sessions/rate limits.
REDIS_URL=rediss://:password@redis.example.com:6380
REDIS_KEY_PREFIX=cloud-bot:production:
REDIS_TLS=true
# Durable queue uses the Redis instance and namespace above. Production requires Redis.

# Storage: production must use s3. Local is dev/test only.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/private
DOWNLOAD_TTL_SECONDS=900
MAX_UPLOAD_BYTES=52428800
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=cloud-bot-production
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=false
